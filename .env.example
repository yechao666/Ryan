AIWO_PORT=4500
AIWO_HOST=127.0.0.1
AIWO_DATA_DIR=./data
AIWO_DB_PATH=./data/aiwo.db
AIWO_PUBLIC_BASE_URL=http://127.0.0.1:4500

# DSH 服务代理（本机）可用：
# AIWO_INSTANCE_TOKEN=aiwo_ins_...
# AIWO_WORKSPACE_ROOT=~/.aiwo/workspaces
# DSH_HOME=~/.dsh
# HIVE_DSH_BIN=dsh

# 任务标题：留空时调用 DSH 生成；设置 AIWO_TITLE_AI=0 可改为内容首行
# AIWO_TITLE_AI=1
# AIWO_DREAM_AI=0 关闭 DSH 归纳，改用本地摘要
# AIWO_DREAM_SCHEDULER=0 关闭后台做梦调度

# 统一认证（OIDC）回调使用的公开地址；留空按请求 Host 推导
# AIWO_PUBLIC_URL=http://127.0.0.1:4500

# 助手：仅使用受限 aiwo_api HTTP 工具，运行目录不指向源码
# AIWO_ASSISTANT_WORKSPACE=~/.aiwo/assistant
