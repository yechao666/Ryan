AIWO_PORT=4500
AIWO_HOST=127.0.0.1
AIWO_DATA_DIR=./data
AIWO_DB_PATH=./data/aiwo.db
AIWO_PUBLIC_BASE_URL=http://127.0.0.1:4500
MNEMOS_BASE_URL=http://127.0.0.1:4380

# DSH 服务代理（本机）可用：
# AIWO_INSTANCE_TOKEN=aiwo_ins_...
# AIWO_WORKSPACE_ROOT=~/.aiwo/workspaces
# DSH_HOME=~/.dsh
# HIVE_DSH_BIN=dsh

# 助手：API helper 与运行目录由服务端创建；不需要暴露源码路径
# AIWO_ASSISTANT_WORKSPACE=~/.aiwo/assistant
# AIWO_ASSISTANT_TOOL_DIR=~/.aiwo/assistant-tools
